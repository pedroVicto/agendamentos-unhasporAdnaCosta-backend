APP_ENV=local

# Porta que você acessa no navegador (mapeada para o Nginx)
APP_PORT=8080

# Chave secreta usada no hash dos códigos de verificação.
# Gere uma com: docker compose exec php php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Endereço do front-end (origem liberada no CORS), ex.: http://localhost:5173
FRONTEND_URL=

# O host do banco é o NOME DO SERVIÇO no docker-compose (postgres),
# nunca "localhost" — os containers se enxergam pela rede interna.
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Primeiro admin, criado por: vendor/bin/phinx seed:run -s AdminSeeder
# A senha precisa ter ao menos 10 caracteres.
ADMIN_EMAIL=
ADMIN_SENHA=

# "log" = o código de verificação só é gravado no log do container (nada é enviado).
# "real" = envia de verdade por e-mail / SMS / WhatsApp.
NOTIFICADOR=real

# E-mail (SMTP). Em desenvolvimento, o Mailpit do docker-compose: host "mailpit", porta 1025.
MAIL_HOST=mailpit
MAIL_PORT=1025
# tls | ssl | vazio
MAIL_ENCRYPTION=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=nao-responda@example.com
MAIL_FROM_NAME=Agendamentos

# SMS e WhatsApp (Twilio). Sem TWILIO_SID, em APP_ENV=local o código vai para o log.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=
# Template de autenticação aprovado no WhatsApp (obrigatório fora do sandbox)
TWILIO_WHATSAPP_CONTENT_SID=
