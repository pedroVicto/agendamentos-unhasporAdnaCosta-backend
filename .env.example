APP_ENV=local

# Porta que você acessa no navegador (mapeada para o Nginx)
APP_PORT=8080

# Chave secreta usada no hash dos códigos de verificação.
# Gere uma com: docker compose exec php php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Endereço do front-end (origem liberada no CORS), ex.: http://localhost:5173
FRONTEND_URL=

# Quando o navegador deve mandar o cookie de sessão (`sessao`).
#   Lax  (padrão) = front e API no MESMO site registrável.
#                   Ex.: seudominio.com + seudominio.com/api, ou api.seudominio.com.
#   None          = front em OUTRO domínio que a API (Vercel + Railway, p.ex.).
#                   Obrigatório nesse caso: com Lax o navegador não envia o
#                   cookie e todo login falha com 401 sem erro visível.
#                   Força Secure, então exige HTTPS nas duas pontas.
#   Strict        = nem em navegação vinda de fora; quebra link de e-mail.
COOKIE_SAMESITE=Lax

# O host do banco é o NOME DO SERVIÇO no docker-compose (postgres),
# nunca "localhost" — os containers se enxergam pela rede interna.
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Primeiro admin, criado por: vendor/bin/phinx seed:run -s AdminSeeder
# A senha precisa ter ao menos 10 caracteres.
ADMIN_EMAIL=
ADMIN_SENHA=

# "log" = o código de verificação só é gravado no log do container (nada é enviado).
# "real" = envia de verdade por e-mail / SMS / WhatsApp.
NOTIFICADOR=real

# E-mail (SMTP). Em desenvolvimento, o Mailpit do docker-compose: host "mailpit", porta 1025.
MAIL_HOST=mailpit
MAIL_PORT=1025
# tls | ssl | vazio
MAIL_ENCRYPTION=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=nao-responda@example.com
MAIL_FROM_NAME=Agendamentos

# SMS e WhatsApp (Twilio). Sem TWILIO_SID, em APP_ENV=local o código vai para o log.
TWILIO_SID=
TWILIO_TOKEN=
# Número comprado na Twilio com capacidade de SMS (conta trial não tem).
TWILIO_FROM_SMS=
# Remetente de WhatsApp da Twilio — NÃO é o seu número pessoal.
# Para testar: +14155238886 (sandbox). Antes, mande "join <código>" do seu
# WhatsApp para esse número (Console > Messaging > Try it out).
TWILIO_FROM_WHATSAPP=+14155238886
# Template de autenticação aprovado no WhatsApp. Obrigatório fora do sandbox:
# sem ele a Twilio recusa a mensagem com 21654 "ContentSid Required". Criado em
# Console > Messaging > Content Template Builder (exige conta paga).
TWILIO_WHATSAPP_CONTENT_SID=

# Fuso do salão. Os horários da agenda são gravados e mostrados nele
# (o banco continua em UTC para created_at, sessões e códigos).
APP_TIMEZONE=America/Sao_Paulo

# Agenda
# De quanto em quanto tempo um atendimento pode começar (09:00, 09:30...)
AGENDA_INTERVALO_MINUTOS=30
# Antecedência mínima para pedir um horário
AGENDA_ANTECEDENCIA_MINUTOS=120
# Até quantos dias à frente o cliente pode agendar
AGENDA_JANELA_DIAS=60
# Quantos pedidos pendentes (ainda sem resposta) um cliente pode ter ao mesmo tempo
AGENDA_MAX_PENDENTES=3
# Até quantas horas antes o cliente pode cancelar um agendamento já confirmado
AGENDA_CANCELAMENTO_HORAS=12
